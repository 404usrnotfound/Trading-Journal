# Run `corepack pnpm env:init` to generate a private .env with unique local credentials.
# This template contains no usable secret values. Do not copy secrets into source control.
NODE_ENV=development
COMPOSE_PROJECT_NAME=trading-journal-foundation
APP_ORIGIN=http://localhost:3000
WEB_HOST=127.0.0.1
PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_SECRET
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5432/trading_journal
DATABASE_URL=postgresql://journal_app:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5432/trading_journal
AUTH_DATABASE_URL=postgresql://journal_auth:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5432/trading_journal
JOB_DATABASE_URL=postgresql://journal_jobs:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5432/trading_journal
TEST_DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5433/trading_journal_test
TEST_APP_DATABASE_URL=postgresql://journal_app:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5433/trading_journal_test
TEST_AUTH_DATABASE_URL=postgresql://journal_auth:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5433/trading_journal_test
TEST_JOB_DATABASE_URL=postgresql://journal_jobs:REPLACE_WITH_LOCAL_RANDOM_SECRET@127.0.0.1:5433/trading_journal_test
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
STORAGE_ROOT=.private/storage
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3101
LOG_LEVEL=info
