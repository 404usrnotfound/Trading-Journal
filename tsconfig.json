{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@tanstack/react-query": ["./apps/web/node_modules/@tanstack/react-query"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/ui/**/*.tsx",
    "vitest*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
